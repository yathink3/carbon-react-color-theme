{
  "$schema": "vscode://schemas/color-theme",
  "name": "Carbon React Color Theme - Trae",
  "type": "dark",
  "colors": {
    "checkbox.border": "#838892",
    "editor.foreground": "#f6f3f3",
    "editor.inactiveSelectionBackground": "#3A3D41",
    "editor.selectionHighlightBackground": "#ADD6FF26",
    "editorBracketMatch.background": "#D5D8E03D",
    "editorBracketMatch.border": "#D5D8E000",
    "list.dropBackground": "#3579ff33",
    "sideBarTitle.foreground": "#BBBBBB",
    "ports.iconRunningProcessForeground": "#369432",
    "tab.selectedForeground": "#ffffffa0",
    "tab.lastPinnedBorder": "#ccc3",
    "list.activeSelectionIconForeground": "#FFF",
    "terminal.inactiveSelectionBackground": "#3A3D41",
    "widget.border": "#303031",
    "actionBar.toggledBackground": "#383a49",
    "editorCursor.foreground": "#fff",
    "editorLineNumber.foreground": "#9599A6",
    "editorLineNumber.activeForeground": "#E0E3EE",
    "editor.selectionBackground": "#3579FF47",
    "editorLink.activeForeground": "#387BFF",
    "editor.background": "#171B26",
    "activityBar.background": "#252A38",
    "sideBar.background": "#171B26",
    "sideBar.border": "#343B4D",
    "activityBarBadge.background": "#171B26",
    "statusBar.background": "#343B4D",
    "statusBarItem.remoteBackground": "#343B4D",
    "statusBarItem.remoteForeground": "#FFF",
    "editorGroupHeader.tabsBackground": "#171B26",
    "selection.background": "#343B4D",
    "sideBarSectionHeader.background": "#171B26",
    "sideBarSectionHeader.border": "#343B4D",
    "editor.tab.background": "#171B26",
    "titleBar.activeBackground": "#252A38",
    "titleBar.inactiveBackground": "#252A38",
    "tab.selectedBackground": "#343B4D",
    "tab.activeBackground": "#171B26",
    "tab.activeBorder": "#6caddf",
    "tab.activeBorderTop": "#6caddf",
    "tab.hoverBackground": "#343B4D",
    "tab.hoverBorder": "#6caddf80",
    "tab.inactiveBackground": "#171B26",
    "tab.unfocusedHoverBackground": "#171B26",
    "editorStickyScrollHover.background": "#282B3A",
    "editorIndentGuide.background1": "#AABCF214",
    "editorIndentGuide.activeBackground1": "#AABCF23D",
    "list.activeSelectionBackground": "#343B4D",
    "list.inactiveSelectionBackground": "#343B4D",
    "list.hoverBackground": "#343B4D",
    "list.focusBackground": "#343B4D",
    "editor.lineHighlightBackground": "#282B3A",
    "input.background": "#171B26"
  },
  "tokenColors": [
    { "scope": ["meta.embedded", "source.groovy.embedded", "string meta.image.inline.markdown", "variable.legacy.builtin.python"], "settings": { "foreground": "#82D99F" } },
    { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
    { "scope": "strong", "settings": { "fontStyle": "bold" } },
    { "scope": "header", "settings": { "foreground": "#569cd6" } },
    { "scope": "comment", "settings": { "foreground": "#737780" } },
    { "scope": "constant.language", "settings": { "foreground": "#80BBFF" } },
    { "scope": ["constant.numeric", "variable.other.enummember", "keyword.operator.plus.exponent", "keyword.operator.minus.exponent"], "settings": { "foreground": "#F48CCA" } },
    { "scope": "constant.regexp", "settings": { "foreground": "#82D99F" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#F2858C" } },
    { "scope": ["entity.name.tag.css", "entity.name.tag.less"], "settings": { "foreground": "#DED47E" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#DED47E" } },
    { "scope": "invalid", "settings": { "foreground": "#CC4B53" } },
    { "scope": "markup.underline", "settings": { "fontStyle": "underline" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold", "foreground": "#D5D8E0" } },
    { "scope": "markup.heading", "settings": { "fontStyle": "bold", "foreground": "#80BBFF" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.strikethrough", "settings": { "fontStyle": "strikethrough" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#66CCAA" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#F2858C" } },
    { "scope": "markup.changed", "settings": { "foreground": "#80BBFF" } },
    { "scope": "punctuation.definition.quote.begin.markdown", "settings": { "foreground": "#737780" } },
    { "scope": "punctuation.definition.list.begin.markdown", "settings": { "foreground": "#F2858C" } },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#82D99F" } },
    { "name": "brackets of XML/HTML tags", "scope": "punctuation.definition.tag", "settings": { "foreground": "#D5D8E0" } },
    { "scope": ["meta.preprocessor", "entity.name.function.preprocessor"], "settings": { "foreground": "#80BBFF" } },
    { "scope": "meta.preprocessor.string", "settings": { "foreground": "#82D99F" } },
    { "scope": "meta.preprocessor.numeric", "settings": { "foreground": "#80BBFF" } },
    { "scope": "meta.structure.dictionary.key.python", "settings": { "foreground": "#82D99F" } },
    { "scope": "meta.diff.header", "settings": { "foreground": "#D5D8E0" } },
    { "scope": "storage", "settings": { "foreground": "#B38CFF" } },
    { "scope": "storage.type", "settings": { "foreground": "#B38CFF" } },
    { "scope": ["storage.modifier", "keyword.operator.noexcept"], "settings": { "foreground": "#B38CFF" } },
    { "scope": ["string", "meta.embedded.assembly"], "settings": { "foreground": "#82D99F" } },
    { "scope": "string.tag", "settings": { "foreground": "#82D99F" } },
    { "scope": "string.value", "settings": { "foreground": "#82D99F" } },
    { "scope": "string.regexp", "settings": { "foreground": "#82D99F" } },
    { "name": "String interpolation", "scope": ["punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end", "punctuation.section.embedded"], "settings": { "foreground": "#F2858C" } },
    { "name": "Reset JavaScript string interpolation expression", "scope": ["meta.template.expression"], "settings": { "foreground": "#B38CFF" } },
    { "scope": ["support.type.vendored.property-name", "support.type.property-name", "source.css variable", "source.coffee.embedded"], "settings": { "foreground": "#D5D8E0" } },
    { "scope": "keyword", "settings": { "foreground": "#B38CFF" } },
    { "scope": "keyword.control", "settings": { "foreground": "#B38CFF" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#D5D8E0" } },
    { "scope": "keyword.other.unit", "settings": { "foreground": "#F48CCA" } },
    { "scope": ["punctuation.section.embedded.begin.php", "punctuation.section.embedded.end.php"], "settings": { "foreground": "#80BBFF" } },
    { "scope": "support.function.git-rebase", "settings": { "foreground": "#9cdcfe" } },
    { "scope": "constant.sha.git-rebase", "settings": { "foreground": "#b5cea8" } },
    { "name": "coloring of the Java import and package identifiers", "scope": ["storage.modifier.import.java", "variable.language.wildcard.java", "storage.modifier.package.java"], "settings": { "foreground": "#D5D8E0" } },
    { "name": "this.self", "scope": "variable.language", "settings": { "foreground": "#DED47E" } },
    { "scope": "log.error", "settings": { "foreground": "#CC4B53" } },
    { "scope": "log.warning", "settings": { "foreground": "#EB9B61" } },
    { "name": "Function declarations", "scope": ["entity.name.function", "support.function", "support.constant.handlebars", "source.powershell variable.other.member", "entity.name.operator.custom-literal"], "settings": { "foreground": "#F29D79" } },
    { "name": "Types declaration and references", "scope": ["support.class", "support.type", "entity.name.type", "entity.name.namespace", "entity.other.attribute", "entity.name.scope-resolution", "entity.name.class", "storage.type.numeric.go", "storage.type.byte.go", "storage.type.boolean.go", "storage.type.string.go", "storage.type.uintptr.go", "storage.type.error.go", "storage.type.rune.go", "storage.type.cs", "storage.type.generic.cs", "storage.type.modifier.cs", "storage.type.variable.cs", "storage.type.annotation.java", "storage.type.generic.java", "storage.type.java", "storage.type.object.array.java", "storage.type.primitive.array.java", "storage.type.primitive.java", "storage.type.token.java", "storage.type.groovy", "storage.type.annotation.groovy", "storage.type.parameters.groovy", "storage.type.generic.groovy", "storage.type.object.array.groovy", "storage.type.primitive.array.groovy", "storage.type.primitive.groovy"], "settings": { "foreground": "#F0D8FF" } },
    { "name": "Variable and parameter name", "scope": ["variable", "meta.definition.variable.name", "support.variable", "entity.name.variable", "constant.other.placeholder"], "settings": { "foreground": "#DED47E" } },
    { "name": "Constants and enums", "scope": ["variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#80BBFF" } },
    { "name": "Object keys, TS grammar specific", "scope": ["meta.object-literal.key"], "settings": { "foreground": "#E0E3EE" } },
    { "name": "CSS property value", "scope": ["support.constant.property-value", "support.constant.font-name", "support.constant.media-type", "support.constant.media", "constant.other.color.rgb-value", "constant.other.rgb-value", "support.constant.color"], "settings": { "foreground": "#82D99F" } },
    { "name": "Regular expression groups", "scope": ["punctuation.definition.group.regexp", "punctuation.definition.group.assertion.regexp", "punctuation.definition.character-class.regexp", "punctuation.character.set.begin.regexp", "punctuation.character.set.end.regexp", "keyword.operator.negation.regexp", "support.other.parenthesis.regexp"], "settings": { "foreground": "#DED47E" } },
    { "scope": ["constant.character.character-class.regexp", "constant.other.character-class.set.regexp", "constant.other.character-class.regexp", "constant.character.set.regexp"], "settings": { "foreground": "#82D99F" } },
    { "scope": ["keyword.operator.or.regexp", "keyword.control.anchor.regexp"], "settings": { "foreground": "#E0E3EE" } },
    { "scope": "keyword.operator.quantifier.regexp", "settings": { "foreground": "#E0E3EE" } },
    { "scope": ["constant.character", "constant.other.option"], "settings": { "foreground": "#80BBFF" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#80BBFF" } },
    { "scope": "entity.name.label", "settings": { "foreground": "#82D99F" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#E0E3EE" } }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "newOperator": "#E0E3EE",
    "stringLiteral": "#82D99F",
    "customLiteral": "#E0E3EE",
    "numberLiteral": "#F48CCA"
  }
}