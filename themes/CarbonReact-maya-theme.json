      }
    },
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#acb6bf8c"
      }
    },
    {
      "name": "String",
      "scope": ["string", "constant.other.symbol"],
